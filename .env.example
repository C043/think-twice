# Copy to `.env` and fill in. Never commit the filled-in file.
# Docker Compose also reads this file to interpolate ${VARS} in the yml files,
# so it holds both application and infrastructure values.

# --- Database ---------------------------------------------------------------
# Used by drizzle.config.ts and src/db/client.ts. Inside Compose the host is
# `postgres`; running the app on the host it is `localhost`.
DATABASE_URL=postgresql://postgres:secret_password@localhost:5432/think_twice_db

# Consumed by docker-compose.yml to provision the Postgres container.
DB_USER=postgres
DB_PASSWORD=secret_password
DB_NAME=think_twice_db

# --- App --------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Public origin of the production deployment. Must be HTTPS: service workers
# and the Push API are disabled on plain HTTP everywhere except localhost.
PROD_APP_URL=https://think-twice.example.com

# --- Web Push (VAPID) -------------------------------------------------------
# Generate a pair with: npx web-push generate-vapid-keys --json
# Rotating these invalidates every stored push subscription, so devices have to
# subscribe again. Keep the private key server-side only.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY is baked into the client bundle at build time and
# must hold the same value as VAPID_PUBLIC_KEY.
VAPID_SUBJECT=mailto:you@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# --- Telegram notifications (optional) --------------------------------------
# Leave empty to skip registering the Telegram provider.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- pgAdmin (dev only) -----------------------------------------------------
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin_password
